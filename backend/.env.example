# =============================================================================
# BaseBoard AI — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Provider routing — change these to switch AI backends without touching code
# -----------------------------------------------------------------------------

# TEXT_PROVIDER:   watsonx | gemini
# Watsonx = script parsing, character extraction, world bible, canon generation
# Gemini  = director engine, shot planning, storyboard intelligence
TEXT_PROVIDER=watsonx

# IMAGE_PROVIDER:  pollinations | huggingface | gemini
# Pollinations = storyboard frames (high volume, no rate limits, free)
# Gemini       = character reference sheets (Imagen 4.0, premium quality)
# Huggingface  = self-hosted / fine-tuned models
IMAGE_PROVIDER=pollinations

# VISION_PROVIDER: gemini
# Gemini Vision = Visual QA, character consistency checks, Visual DNA extraction
VISION_PROVIDER=gemini

# -----------------------------------------------------------------------------
# IBM WatsonX  (required when TEXT_PROVIDER=watsonx)
# -----------------------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model fallback chain — tried in order on rate-limit / model errors.
# Leave FALLBACK and LAST_RESORT empty to use only the primary model.
WATSONX_PRIMARY_TEXT_MODEL=meta-llama/llama-3-3-70b-instruct
WATSONX_FALLBACK_TEXT_MODEL=mistralai/mistral-small-3-1-24b-instruct-2503
WATSONX_LAST_RESORT_MODEL=meta-llama/llama-3-1-8b

# -----------------------------------------------------------------------------
# Google Gemini  (required when TEXT_PROVIDER=gemini, IMAGE_PROVIDER=gemini,
#                 or VISION_PROVIDER=gemini)
# Get your key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Model IDs — change to upgrade without touching code
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# -----------------------------------------------------------------------------
# Hugging Face  (required when IMAGE_PROVIDER=huggingface)
# -----------------------------------------------------------------------------
HF_API_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_IMG2IMG_MODEL=stabilityai/stable-diffusion-xl-refiner-1.0

# -----------------------------------------------------------------------------
# Pollinations  (IMAGE_PROVIDER=pollinations — no API key required)
# -----------------------------------------------------------------------------
POLLINATIONS_WIDTH=768
POLLINATIONS_HEIGHT=512
