# ---------------------------------------------------------------
# BaseBoardAI — Environment Configuration Template
# Safe to commit. Copy to .env and fill in real values.
# ---------------------------------------------------------------

# --- IBM WatsonX Granite (LLM) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Region endpoint — change to match your watsonx instance region:
#   us-south → https://us-south.ml.cloud.ibm.com  (default)
#   eu-de    → https://eu-de.ml.cloud.ibm.com
#   eu-gb    → https://eu-gb.ml.cloud.ibm.com
#   jp-tok   → https://jp-tok.ml.cloud.ibm.com
#   au-syd   → https://au-syd.ml.cloud.ibm.com
# Find your URL in the IBM Cloud console under Watson Studio → Manage → General
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# --- Image Generation ---
# Accepted values: pollinations | huggingface
IMAGE_PROVIDER=pollinations

# Hugging Face (only required when IMAGE_PROVIDER=huggingface)
HF_API_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_IMG2IMG_MODEL=stabilityai/stable-diffusion-xl-refiner-1.0

# Pollinations dimensions (used by both providers for consistent canvas sizing)
POLLINATIONS_WIDTH=768
POLLINATIONS_HEIGHT=512
