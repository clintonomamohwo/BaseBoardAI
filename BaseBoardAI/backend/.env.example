# ---------------------------------------------------------------
# BaseBoardAI — Environment Configuration Template
# Safe to commit. Copy to .env and fill in real values.
# ---------------------------------------------------------------

# --- IBM WatsonX Granite (LLM) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# --- Image Generation ---
# Accepted values: pollinations | huggingface
IMAGE_PROVIDER=pollinations

# Hugging Face (only required when IMAGE_PROVIDER=huggingface)
HF_API_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Pollinations dimensions (used by both providers for consistent canvas sizing)
POLLINATIONS_WIDTH=768
POLLINATIONS_HEIGHT=512
