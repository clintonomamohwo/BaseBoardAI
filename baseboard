#!/usr/bin/env bash
# =============================================================================
# baseboard — run the BaseBoard AI backend from any directory
#
# Usage:
#   ./baseboard          start the API (hot-reload on)
#   ./baseboard --prod   start without hot-reload (production-like)
#   ./baseboard --help   show this message
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$SCRIPT_DIR/backend"
VENV="$BACKEND_DIR/.venv"

# ── Help ──────────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  sed -n '2,8p' "$0" | sed 's/^# //'
  exit 0
fi

# ── Sanity checks ─────────────────────────────────────────────────────────────
if [[ ! -d "$BACKEND_DIR" ]]; then
  echo "❌  backend/ directory not found alongside this script."
  exit 1
fi

if [[ ! -d "$VENV" ]]; then
  echo "⚙️  No virtual environment found. Creating one now…"
  python3 -m venv "$VENV"
  echo "📦  Installing requirements…"
  "$VENV/bin/pip" install --quiet -r "$BACKEND_DIR/requirements.txt"
fi

if [[ ! -f "$BACKEND_DIR/.env" ]]; then
  if [[ -f "$BACKEND_DIR/.env.example" ]]; then
    cp "$BACKEND_DIR/.env.example" "$BACKEND_DIR/.env"
    echo ""
    echo "⚠️  .env file created from .env.example."
    echo "    Fill in your API keys at: $BACKEND_DIR/.env"
    echo "    Then re-run: ./baseboard"
    echo ""
    exit 1
  else
    echo "❌  No .env file found in $BACKEND_DIR."
    echo "    Create one based on .env.example before starting."
    exit 1
  fi
fi

# ── Activate venv ─────────────────────────────────────────────────────────────
# shellcheck disable=SC1091
source "$VENV/bin/activate"

# ── Launch ────────────────────────────────────────────────────────────────────
RELOAD_FLAG="--reload"
if [[ "${1:-}" == "--prod" ]]; then
  RELOAD_FLAG=""
  echo "🚀  Starting BaseBoard AI backend (production mode)…"
else
  echo "🚀  Starting BaseBoard AI backend (dev mode, hot-reload on)…"
fi

echo "    API  → http://localhost:8000"
echo "    Docs → http://localhost:8000/docs"
echo ""

# Change into backend/ so uvicorn and pydantic-settings resolve paths correctly
cd "$BACKEND_DIR"
exec uvicorn app.main:app $RELOAD_FLAG --host 0.0.0.0 --port 8000
